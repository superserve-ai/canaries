          }
        },
        {
          title = "Pause API request duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE",
  "legendTemplate": "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE",
  "legendTemplate": "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE",
  "legendTemplate": "p99"
              }
            ]
          }
        },
        {
          title = "Pause readiness duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_wait_paused\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE",
  "legendTemplate": "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_wait_paused\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE",
  "legendTemplate": "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_wait_paused\"}[30m])))",
                    environment
