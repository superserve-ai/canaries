${jsonencode({
  displayName = "${environment} API canary"
  gridLayout = {
    columns = 4
    widgets = concat(
      [
        {
          text = {
            content = "# Canary Lifecycle\nProject: ${project_id}\n\nEnvironment: ${environment}\n\nTargets:\n${join("\n", [for target in targets : "- ${target.target} (${target.region})"])}"
            format  = "MARKDOWN"
          }
        }
      ],
      flatten([
        for target in targets : [
          {
            title = "Last run"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "((max by (target) (max_over_time(superserve_canary_last_success_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=\"success\"}[24h])) or label_replace(vector(0), \"target\", %q, \"\", \"\")) + 5 >= bool (max by (target) (max_over_time(superserve_canary_last_completed_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\"}[24h])) or label_replace(vector(9999999999), \"target\", %q, \"\", \"\")))",
                  environment,
                  target.region,
                  target.target,
                  target.target,
                  environment,
                  target.region,
                  target.target,
                  target.target
                )
              }
              thresholds = [
                {
                  color = "RED"
                  direction = "BELOW"
                  label = "Failure"
                  value = 0.5
                }
              ]
            }
          },
          {
            title = "End-to-end canary health"
            xyChart = {
              chartOptions = {
                mode = "COLOR"
              }
              dataSets = [
                {
                  timeSeriesQuery = {
                    prometheusQuery = format(
                      "((sum(increase(superserve_canary_run_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=~\"success|failure\"}[15m])) or vector(0)) > bool 0) * (((max_over_time(superserve_canary_last_success_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=\"success\"}[15m]) or vector(0)) + 5) >= bool (max_over_time(superserve_canary_last_completed_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\"}[15m]) or vector(0)))",
                      environment,
                      target.region,
                      target.target,
                      environment,
                      target.region,
                      target.target,
                      environment,
                      target.region,
                      target.target
                    )
                  }
                  plotType = "STACKED_BAR"
                  legendTemplate = "Healthy"
                },
                {
                  timeSeriesQuery = {
                    prometheusQuery = format(
                      "((sum(increase(superserve_canary_run_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=~\"success|failure\"}[15m])) or vector(0)) > bool 0) * (1 - (((max_over_time(superserve_canary_last_success_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=\"success\"}[15m]) or vector(0)) + 5) >= bool (max_over_time(superserve_canary_last_completed_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\"}[15m]) or vector(0))))",
                      environment,
                      target.region,
                      target.target,
                      environment,
                      target.region,
                      target.target,
                      environment,
                      target.region,
                      target.target
                    )
                  }
                  plotType = "STACKED_BAR"
                  legendTemplate = "Failing"
                },
                {
                  timeSeriesQuery = {
                    prometheusQuery = format(
                      "1 - ((sum(increase(superserve_canary_run_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=~\"success|failure\"}[15m])) or vector(0)) > bool 0)",
                      environment,
                      target.region,
                      target.target
                    )
                  }
                  plotType = "STACKED_BAR"
                  legendTemplate = "No recent completed run"
                }
              ]
            }
          },
          {
            title = "Failures in last 15m"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "increase(superserve_canary_run_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=\"failure\"}[15m]) or vector(0)",
                  environment,
                  target.region,
                  target.target
                )
              }
              sparkChartView = {
                sparkChartType = "SPARK_LINE"
              }
              thresholds = [
                {
                  color = "RED"
                  direction = "ABOVE"
                  label = "Any failures"
                  value = 0.5
                }
              ]
            }
          },
          {
            title = "Time since last successful run (s)"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "(time() - max_over_time(superserve_canary_last_success_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=\"success\"}[24h]))",
                  environment,
                  target.region,
                  target.target
                )
              }
              sparkChartView = {
                sparkChartType = "SPARK_LINE"
              }
              thresholds = [
                {
                  color = "RED"
                  direction = "ABOVE"
                  label = "Stale"
                  value = 720
                },
                {
                  color = "YELLOW"
                  direction = "ABOVE"
                  label = "Aging"
                  value = 420
                }
              ]
            }
          },
          {
            title = "Success rate (6h rolling) (%)"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "((100 * sum(increase(superserve_canary_run_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=\"success\"}[6h])) / clamp_min(sum(increase(superserve_canary_run_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\"}[6h])), 0.000001)) or vector(0))",
                  environment,
                  target.region,
                  target.target,
                  environment,
                  target.region,
                  target.target
                )
              }
              sparkChartView = {
                sparkChartType = "SPARK_LINE"
              }
              thresholds = [
                {
                  color = "RED"
                  direction = "BELOW"
                  label = "Below 80%"
                  value = 80
                },
                {
                  color = "YELLOW"
                  direction = "BELOW"
                  label = "Below 100%"
                  value = 100
                }
              ]
            }
          },
          {
            title = "Overlap skips"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "increase(superserve_canary_overlap_skipped_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\"}[24h]) or vector(0)",
                  environment,
                  target.region,
                  target.target
                )
              }
              sparkChartView = {
                sparkChartType = "SPARK_LINE"
              }
              thresholds = [
                {
                  color = "YELLOW"
                  direction = "ABOVE"
                  label = "Any skips"
                  value = 0.5
                }
              ]
            }
          },
          {
            title = "Failed runs retained for debugging"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "sum(increase(superserve_canary_retained_sandbox_total{environment=%q,region=%q,target=%q,scenario=\"lifecycle\",result=\"retained\"}[24h])) or vector(0)",
                  environment,
                  target.region,
                  target.target
                )
              }
              sparkChartView = {
                sparkChartType = "SPARK_LINE"
              }
              thresholds = [
                {
                  color = environment == "production" ? "RED" : "YELLOW"
                  direction = "ABOVE"
                  label = "Any retained runs"
                  value = 0.5
                }
              ]
            }
          },
          {
            title = "Running executions"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "superserve_canary_running_executions{environment=%q,region=%q,target=%q,scenario=\"lifecycle\"} or vector(0)",
                  environment,
                  target.region,
                  target.target
                )
              }
            }
          },
          {
            text = {
              content = "## Scheduler liveness"
              format  = "MARKDOWN"
            }
          },
          {
            title = "Last lifecycle completion age (s)"
            scorecard = {
              timeSeriesQuery = {
                prometheusQuery = format(
                  "(time() - max_over_time(superserve_canary_last_completed_timestamp_seconds{environment=%q,region=%q,target=%q,scenario=\"lifecycle\"}[24h]))",
                  environment,
                  target.region,
                  target.target
                )
              }
              thresholds = [
                {
                  color = "RED"
                  direction = "ABOVE"
                  label = "Stale"
                  value = 720
                },
                {
                  color = "YELLOW"
                  direction = "ABOVE"
                  label = "Aging"
                  value = 420
                }
              ]
            }
          },
        ]
      ]),
      [
        {
          text = {
            content = "## Lifecycle success / failure"
            format  = "MARKDOWN"
          }
        },
        {
          title = "Lifecycle successes"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "sum by (target) (increase(superserve_canary_run_total{environment=%q,scenario=\"lifecycle\",result=\"success\"}[15m]))",
                    environment
                  )
                }
                plotType = "LINE"
              }
            ]
          }
        },
        {
          title = "Lifecycle failures"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "sum by (target) (increase(superserve_canary_run_total{environment=%q,scenario=\"lifecycle\",result=\"failure\"}[15m]))",
                    environment
                  )
                }
                plotType = "LINE"
              }
            ]
          }
        },
        {
          title = "Lifecycle success rate"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "100 * sum by (target) (rate(superserve_canary_run_total{environment=%q,scenario=\"lifecycle\",result=\"success\"}[15m])) / sum by (target) (rate(superserve_canary_run_total{environment=%q,scenario=\"lifecycle\"}[15m]))",
                    environment,
                    environment
                  )
                }
                plotType = "LINE"
              }
            ]
          }
        },
        {
          text = {
            content = "## Lifecycle timing"
            format  = "MARKDOWN"
          }
        },
        {
          title = "Create -> sandbox active"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"create_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"create_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"create_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "Pause -> sandbox paused"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "Resume -> sandbox active"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"resume_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"resume_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"resume_total\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "End-to-end canary run duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_run_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_run_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_run_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "Create API request duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"create_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"create_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"create_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "Pause API request duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"pause_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "Resume API request duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"resume_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"resume_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"resume_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "Preview URL readiness duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"preview\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"preview\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"preview\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          title = "Delete API request duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"delete_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p50"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.95, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"delete_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p95"
              },
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"delete_request\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE"
                legendTemplate = "p99"
              }
            ]
          }
        },
        {
          text = {
            content = "## Failure breakdown"
            format  = "MARKDOWN"
          }
        },
        {
          title = "Failure breakdown by step"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "sum by (target, step) (increase(superserve_canary_step_total{environment=%q,scenario=\"lifecycle\",result=\"failure\"}[1h]))",
                    environment
                  )
                }
                plotType = "LINE"
              }
            ]
          }
        }
      ])
  }
})}
