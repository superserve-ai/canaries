                    "histogram_quantile(0.99, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"resume_wait_active\"}[30m])))",
                    environment
                  )
                }
                plotType = "LINE",
  "legendTemplate": "p99"
              }
            ]
          }
        },
        {
          title = "Preview URL readiness duration"
          xyChart = {
            dataSets = [
              {
                timeSeriesQuery = {
                  prometheusQuery = format(
                    "histogram_quantile(0.50, sum by (le, target) (rate(superserve_canary_step_duration_seconds_bucket{environment=%q,scenario=\"lifecycle\",step=\"preview\"}[30m])))",
